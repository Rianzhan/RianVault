# RianVault environment template — copy to .env and fill real values locally.
# NEVER put real values in this file. NEVER commit .env.

# --- database ---
# dev default is a local sqlite file (zero-dependency). prod uses PostgreSQL (compose sets this).
DATABASE_URL=sqlite:///./rianvault-dev.db
# DATABASE_URL=postgresql+psycopg://rianvault:CHANGE_ME@db:5432/rianvault

# --- qdrant (phase 1 semantic index; not needed until T6) ---
QDRANT_URL=http://localhost:6333
QDRANT_MINIMAL_PAYLOAD=false

# --- embedding (local only; model weights download once, then offline) ---
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
CHUNK_MAX_TOKENS=600

# --- auth tokens (T4). generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
RIANVAULT_OWNER_TOKEN=CHANGE_ME_owner_token
RIANVAULT_ZHAN_TOKEN=CHANGE_ME_zhan_token

# --- import ---
IMPORT_MAX_FILE_MB=512

# --- logging ---
LOG_LEVEL=INFO
