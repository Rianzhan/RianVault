# RianVault environment template — copy to .env and fill real values locally.
# NEVER put real values in this file. NEVER commit .env.

# --- database ---
# dev default is a local sqlite file (zero-dependency). prod uses PostgreSQL (compose sets this).
DATABASE_URL=sqlite:///./rianvault-dev.db
# DATABASE_URL=postgresql+psycopg://rianvault:CHANGE_ME@db:5432/rianvault

# --- qdrant (语义索引；可丢弃、可重建，权威真源是 PostgreSQL) ---
# local = 进程内/本地文件存储（没装 docker 也能跑）；server = compose 容器
QDRANT_MODE=local
QDRANT_PATH=./data/qdrant
# QDRANT_MODE=server
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=rianvault_chunks
# true 时 payload 只保留 chunk_id + conversation_id（其余过滤条件回查 PG）
QDRANT_MINIMAL_PAYLOAD=false

# --- embedding (local only; model weights download once, then offline) ---
EMBEDDING_PROVIDER=sentence-transformers
# 可以是 HuggingFace 模型名（首次自动下载），也可以是本机目录（离线/锁定版本时更稳）
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
CHUNK_MAX_TOKENS=600

# --- auth tokens ---
# tokens 存于 api_tokens 表（SHA-256 哈希），不在 env 中配置。
# 铸造：python scripts/create_token.py --role owner --name "Owner的主 token"（明文只显示一次）

# --- import ---
IMPORT_MAX_FILE_MB=512

# --- logging ---
LOG_LEVEL=INFO
# 排查时才开：未处理异常会打印完整堆栈（可能夹带 SQL 参数＝正文）
DEBUG=false

# 加固：写操作与检索的每客户端限流（0 = 关闭）
RATE_LIMIT_PER_MINUTE=120
SECURITY_HEADERS=true
